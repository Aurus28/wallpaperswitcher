<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">

    <group name="General">
        <entry name="folderPath" type="Path">
            <default></default>
        </entry>
        <entry name="popupWidth" type="Int">
            <default>600</default>
        </entry>

        <entry name="popupHeight" type="Int">
            <default>400</default>
        </entry>

        <entry name="pictureWidth" type="Int">
            <default>90</default>
        </entry>

        <entry name="pictureHeight" type="Int">
            <default>90</default>
        </entry>
    </group>

</kcfg>
