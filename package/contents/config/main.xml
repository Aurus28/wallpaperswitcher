<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">

    <group name="General">
        <entry name="folderPath" type="Path">
            <default></default>
        </entry>
        <entry name="aspectX" type="Int">
            <default>16</default>
        </entry>

        <entry name="aspectY" type="Int">
            <default>9</default>
        </entry>

        <entry name="rowCount" type="Int">
            <default>2</default>
        </entry>

        <entry name="colCount" type="Int">
            <default>4</default>
        </entry>

        <entry name="margins" type="Int">
            <default>10</default>
        </entry>

        <entry name="imageWidth" type="Int">
            <default>200</default>
        </entry>

        <entry name="hideUnlessEditMode" type="Bool">
            <default>false</default>
        </entry>

        <entry name="changeLockscreen" type="Bool">
            <default>false</default>
        </entry>
    </group>

</kcfg>
